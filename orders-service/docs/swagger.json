{
    "swagger": "2.0",
    "info": {
        "description": "API for Golang app",
        "title": "Golang app API",
        "contact": {},
        "version": "1.0"
    },
    "host": "127.0.0.1:5051",
    "basePath": "/api/v1",
    "paths": {
        "/orders": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns all orders belonging to the authenticated user",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Orders"
                ],
                "summary": "List user's orders",
                "responses": {
                    "200": {
                        "description": "List of orders",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.ListOrdersResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_pkg_httpserver_response.ErrorsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_pkg_httpserver_response.ErrorsResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Creates a new order for the authenticated user\nSends a message to Kafka when order is created",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Orders"
                ],
                "summary": "Create a new order",
                "parameters": [
                    {
                        "description": "Order data",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.CreateOrderRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Order created",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.CreateOrderResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_pkg_httpserver_response.ErrorsResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_pkg_httpserver_response.ErrorsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_pkg_httpserver_response.ErrorsResponse"
                        }
                    }
                }
            }
        },
        "/orders/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns order details. User can only access their own orders.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Orders"
                ],
                "summary": "Get order by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Order ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order details",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.GetOrderResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_pkg_httpserver_response.ErrorsResponse"
                        }
                    },
                    "403": {
                        "description": "Access denied",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_pkg_httpserver_response.ErrorsResponse"
                        }
                    },
                    "404": {
                        "description": "Order not found",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_pkg_httpserver_response.ErrorsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_pkg_httpserver_response.ErrorsResponse"
                        }
                    }
                }
            }
        }
