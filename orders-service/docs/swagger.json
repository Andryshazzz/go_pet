            "properties": {
                "order": {
                    "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.OrderDTO"
                }
            }
        },
        "github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.GetOrderResponse": {
            "type": "object",
            "properties": {
                "order": {
                    "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.OrderDTO"
                }
            }
        },
        "github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.ListOrdersResponse": {
            "type": "object",
            "properties": {
                "orders": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.OrderDTO"
                    }
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.OrderDTO": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.OrderItemDTO"
                    }
                },
                "status": {
                    "type": "string"
                },
                "total_price": {
                    "type": "number"
                },
                "updated_at": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "github_com_Andryshazzz_go_pet_orders-service_internal_domain_dto.OrderItemDTO": {
            "type": "object",
            "required": [
                "name",
                "price",
                "quantity"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 1,
                    "example": "Pizza"
                },
                "price": {
                    "type": "number",
                    "minimum": 0,
                    "example": 12.5
                },
                "quantity": {
                    "type": "integer",
                    "maximum": 1000,
                    "minimum": 1,
                    "example": 2
                }
            }
        },
        "github_com_Andryshazzz_go_pet_orders-service_pkg_httpserver_response.ErrorsResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "description": "Error contains the technical error details for debugging.",
                    "type": "string"
                },
                "message": {
                    "description": "Message contains the human-readable error description.",
                    "type": "string"
                }
            }
